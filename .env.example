# ============================================================
# InstantStore Client - Environment Configuration Template
# For Localhost: Copy to .env
# For Vercel: Set these in Vercel Project Settings -> Environment Variables
# ============================================================

# Backend API Gateway URL
# Local: http://localhost:5000
# Production: https://your-instantstore-api.onrender.com
VITE_API_URL=http://localhost:5000

# Clerk Authentication (Publishable Key from Clerk Dashboard)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Cloudinary CDN Uploads
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# Parent Wildcard Domain (e.g. devtackle.in)
VITE_BASE_DOMAIN=devtackle.in
