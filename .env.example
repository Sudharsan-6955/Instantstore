# ============================================================
# InstantStore Client - Environment Configuration Template
# For Localhost: Copy to .env
# For Vercel: Set these in Vercel Project Settings -> Environment Variables
# ============================================================

# Backend API Gateway URL
# Local: http://localhost:5000
# Production: https://instantstore-server.onrender.com (or https://api.devtackle.in)
VITE_API_URL=http://localhost:5000

# Clerk Authentication (Publishable Key from https://dashboard.clerk.com)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_aGFuZHktZW11LTYxLmNsZXJrLmFjY291bnRzLmRldiQ

# Cloudinary CDN Uploads (For Logo, Banners, and Catalog Products)
VITE_CLOUDINARY_CLOUD_NAME=dt2xm7jiq
VITE_CLOUDINARY_UPLOAD_PRESET=instantstore

# Parent Wildcard Domain (e.g. devtackle.in)
# In production, wildcard routing maps *.devtackle.in to tenant storefronts
VITE_BASE_DOMAIN=devtackle.in
